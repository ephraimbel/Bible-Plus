<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Bible+ uses your microphone for voice conversations with the AI companion. Audio is processed on-device and never recorded.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Bible+ converts your spoken words to text so you can talk with the AI companion hands-free. Recognition runs on-device when possible.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>Bible Plus uses this to measure ad performance and help us reach people who would benefit from the app. Your data is never sold.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.bibleplus.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bibleplus</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
