build/
DerivedData/
.build/
*.xcodeproj/
*.xcworkspace/
DerivedSources/
*.xcuserstate
xcuserdata/
CompilationCache.noindex/
Index.noindex/
ModuleCache.noindex/
SDKStatCaches.noindex/
SwiftExplicitPrecompiledModules/
XCBuildData/

# Generated / binary
*.ipa
*.dSYM
*.dSYM.zip
*.app
*.framework
*.xcarchive

# Images & media (no code context)
Resources/Sounds/
Resources/Backgrounds/
website/images/
*.png
*.jpg
*.jpeg
*.gif
*.mp3
*.m4a
*.mp4
