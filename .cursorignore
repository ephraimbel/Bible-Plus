*.wav

# Large bundled content JSON (app loads at runtime — AI doesn't need full text)
Shared/Content/bible-kjv.json
Shared/Content/bible-web.json

# Dependency caches
node_modules/
Pods/
.swiftpm/
Package.resolved

# Supabase build artifacts (keep source)
supabase/.branches/
supabase/.temp/

# System
.DS_Store
*.log
