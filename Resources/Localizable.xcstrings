    "You can withdraw permission anytime in Settings › AI & Privacy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can withdraw permission anytime in Settings › AI & Privacy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode retirar a permissão a qualquer momento nas Configurações › IA & Privacidade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können die Erlaubnis jederzeit in den Einstellungen › KI & Datenschutz widerrufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez retirer votre autorisation à tout moment dans les paramètres › IA et confidentialité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes retirar el permiso en cualquier momento en Configuración › IA y Privacidad."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode retirar a permissão a qualquer momento nas Definições › IA & Privacidade."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi revocare il permesso in qualsiasi momento nelle impostazioni › AI e Privacy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt toestemming op elk moment intrekken in Instellingen › AI & Privacy."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan trekke tilbake tillatelsen når som helst i Innstillinger › AI & Personvern."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan återkalla tillstånd när som helst i Inställningar › AI & Integritet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan trække tilladelsen tilbage når som helst i Indstillinger › AI & Privatliv."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz cofnąć zgodę w dowolnym momencie w Ustawieniach › AI i Prywatność."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit peruuttaa luvan milloin tahansa Asetuksissa › AI & Tietosuoja."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolení můžete kdykoli odvolat v Nastavení › AI a Ochrana soukromí."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți retrage permisiunea oricând în Setări › AI și Confidențialitate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármikor visszavonhatod a hozzájárulást a Beállítások › AI & Adatvédelem menüpont alatt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете отозвать разрешение в любое время в Настройках › ИИ и конфиденциальность."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να ανακαλέσετε την άδεια οποιαδήποτε στιγμή στις Ρυθμίσεις › AI & Απορρήτου."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzni istediğiniz zaman Ayarlar › AI & Gizlilik'ten geri alabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以随时在设置 › AI与隐私中撤回权限。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете відкликати дозвіл у будь-який час у Налаштуваннях › ШІ та конфіденційність."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以隨時在設定 › AI 與隱私中撤回許可。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 › AI & プライバシーでいつでも許可を取り消すことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 › AI 및 개인정보 보호에서 언제든지 권한을 철회할 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप सेटिंग्स › AI & गोपनीयता में कभी भी अनुमति वापस ले सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যেকোনো সময় অনুমতি প্রত্যাহার করতে পারেন সেটিংসে › AI এবং গোপনীয়তা।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کسی بھی وقت سیٹنگز › AI اور رازداری میں اجازت واپس لے سکتے ہیں۔"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك سحب الإذن في أي وقت من الإعدادات › الذكاء الاصطناعي والخصوصية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat menarik izin kapan saja di Pengaturan › AI & Privasi."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شما می‌توانید هر زمان که بخواهید مجوز را در تنظیمات › AI و حریم خصوصی لغو کنید."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menarik balik kebenaran bila-bila masa dalam Tetapan › AI & Privasi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถถอนการอนุญาตได้ทุกเมื่อในการตั้งค่า › AI & ความเป็นส่วนตัว"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaari mong bawiin ang pahintulot anumang oras sa Mga Setting › AI at Privacy."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể rút lại quyền cho bất kỳ lúc nào trong Cài đặt › AI & Quyền riêng tư."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unaweza kujiondoa ruhusa wakati wowote kwenye Mipangilio › AI na Faragha."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jy kan toestemming enige tyd intrek in Instellings › KI & Privaatheid."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ka iya janye izini a kowane lokaci a cikin Saituna › AI & Sirri."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "O le fa aṣẹ rẹ pada nigbakugba ninu Eto › AI & Asiri."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በቅንብር ውስጥ ወይም AI እና የውሂብ ውል ውስጥ የፈቃድ ማስታወሻ ይወገዱ ወይም ይቆርጡ።"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה יכול למשוך את ההסכמה בכל עת בהגדרות › בינה מלאכותית ופרטיות."
          }
        }
      }
    },
