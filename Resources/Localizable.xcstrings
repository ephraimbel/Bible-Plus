    "Bible Plus couldn't open its database. Please try restarting the app. If the problem persists, reinstalling may help.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Plus couldn't open its database. Please try restarting the app. If the problem persists, reinstalling may help."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Plus no pudo abrir su base de datos. Intenta reiniciar la app. Si el problema persiste, reinstalar puede ayudar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bible Plus não conseguiu abrir seu banco de dados. Tente reiniciar o app. Se o problema persistir, reinstalar pode ajudar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Plus n'a pas pu ouvrir sa base de données. Essayez de redémarrer l'application. Si le problème persiste, réinstaller peut aider."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Plus konnte die Datenbank nicht öffnen. Versuche, die App neu zu starten. Wenn das Problem bleibt, hilft eine Neuinstallation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Plus non è riuscito ad aprire il database. Prova a riavviare l'app. Se il problema persiste, reinstallare può aiutare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Plus nie mógł otworzyć bazy danych. Uruchom aplikację ponownie. Jeśli problem się utrzymuje, zainstaluj ją jeszcze raz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Plus не смог открыть базу данных. Перезапусти приложение. Если проблема не исчезнет, попробуй переустановить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Plus 无法打开数据库。请尝试重启应用。如果问题仍然存在,重新安装可能会有所帮助。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Plus 無法開啟資料庫。請嘗試重新啟動應用程式。若問題仍在,重新安裝可能有幫助。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Plus가 데이터베이스를 열 수 없어요. 앱을 다시 시작해 보세요. 문제가 계속되면 재설치가 도움이 될 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Plusはデータベースを開けませんでした。アプリを再起動してください。問題が続く場合は、再インストールをお試しください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Plus tidak bisa membuka basis data. Coba restart aplikasi. Jika masih bermasalah, instal ulang bisa membantu."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mabuksan ng Bible Plus ang database. Subukang i-restart ang app. Kung nagpapatuloy, makakatulong ang muling pag-install."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Plus haikuweza kufungua hifadhidata yake. Tafadhali jaribu kuanzisha upya programu. Kama tatizo likiendelea, kusakinisha upya kunaweza kusaidia."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Plus የመረጃ ቋት መክፈት አልቻለም። መተግበሪያውን እንደገና አስጀምር። ችግሩ ከቀጠለ እንደገና መጫን ሊረዳ ይችላል።"
          }
        }
      }
    },
