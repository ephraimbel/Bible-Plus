        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це формує вірші та молитви, які ми обираємо для вас."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這影響我們為您選擇的經文和祈禱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これがあなたのために選ぶ節と祈りを形作ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 우리가 귀하를 위해 선택하는 구절과 기도를 형성합니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उन पदों और प्रार्थनाओं को आकार देता है जो हम आपके लिए चुनते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি সেই শ্লোক এবং প্রার্থনাগুলি গঠন করে যা আমরা আপনার জন্য নির্বাচন করি।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ان آیات اور دعاؤں کی تشکیل کرتا ہے جو ہم آپ کے لیے منتخب کرتے ہیں۔"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يشكل الآيات والصلوات التي نختارها لك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini membentuk ayat dan doa yang kami pilih untuk Anda."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این آیات و دعاهایی را که برای شما انتخاب می‌کنیم شکل می‌دهد."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini membentuk ayat dan doa yang kami pilih untuk anda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือสิ่งที่กำหนดข้อพระคัมภีร์และคำอธิษฐานที่เราคัดสรรให้คุณ"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ito ang humuhubog sa mga taludtod at panalangin na pinipili namin para sa iyo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều này định hình các câu Kinh thánh và lời cầu nguyện mà chúng tôi chọn cho bạn."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hii inaboresha mistari na sala tunazochagua kwa ajili yako."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit vorm die verse en gebede wat ons vir jou kies."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan yana tsara ayoyi da addu'o'in da muke zaɓa maka."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyi n ṣe apẹrẹ awọn ẹsẹ ati awọn adura ti a yan fun ọ."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ ለእርስዎ የምንምር ክፍሎች እና ጸሎቶችን ይቀይር።"
          }
        },
        "he": {
