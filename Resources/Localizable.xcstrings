    "%@ free trial, then %@ per year. Auto-renews until cancelled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ free trial, then %@ per year. Auto-renews until cancelled."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ teste grátis, depois %@ por ano. Renova automaticamente até ser cancelado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ prueba gratuita, luego %@ por año. Se renueva automáticamente hasta que se cancele."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kostenlose Testversion, danach %@ pro Jahr. Verlängert sich automatisch, bis sie gekündigt wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ essai gratuit, puis %@ par an. Renouvelle automatiquement jusqu'à annulation."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de teste gratuito, depois %@ por ano. Renova automaticamente até ser cancelado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ prova gratuita, poi %@ all'anno. Si rinnova automaticamente fino a cancellazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gratis proefperiode, daarna %@ per jaar. Verlengt automatisch totdat geannuleerd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gratis prøve, deretter %@ per år. Fornyes automatisk til det avbestilles."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gratisprov, sedan %@ per år. Förnyas automatiskt tills det avbryts."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gratis prøveperiode, derefter %@ om året. Fornyes automatisk indtil afbestilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ darmowy test, potem %@ rocznie. Automatycznie odnawia się do momentu anulowania."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ilmaiskoe, sitten %@ vuodessa. Uudistuu automaattisesti, kunnes peruutat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zdarma zkouška, poté %@ ročně. Automaticky se obnovuje, dokud nebude zrušena."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ trial gratuit, apoi %@ pe an. Se reînnoiește automat până la anulare."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ingyenes próba, majd %@ évente. Automatikusan megújul, amíg le nem mondod."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ δωρεάν δοκιμή, στη συνέχεια %@ ανά έτος. Αυτοανανεώνεται μέχρι να ακυρωθεί."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ бесплатный период, затем %@ в год. Авто-продление до отмены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ücretsiz deneme, ardından %@ yıllık. İptal edilene kadar otomatik olarak yenilenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 免费试用，之后每年 %@。自动续订，直至取消。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ безкоштовний тестовий період, потім %@ на рік. Автоматично продовжується, поки не скасовано."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 免費試用，然後每年 %@。自動續訂，直到取消。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 무료 체험 후, 연간 %@. 취소할 때까지 자동 갱신됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 無料トライアル、その後は %@ 年ごとに自動更新されます。キャンセルするまで自動更新されます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ मुफ्त परीक्षण, फिर %@ प्रति वर्ष। रद्द किए जाने तक स्वचालित रूप से नवीनीकरण होता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ফ্রি ট্রায়াল, তারপর %@ প্রতি বছর। বাতিল না হওয়া পর্যন্ত স্বয়ংক্রিয়ভাবে নবায়ন হয়।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ مفت آزمائش، پھر %@ فی سال۔ خود بخود تجدید ہوتا ہے جب تک کہ منسوخ نہ کیا جائے۔"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ تجربة مجانية، ثم %@ سنويًا. تتجدد تلقائيًا حتى يتم الإلغاء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ניסיון חינם, לאחר מכן %@ לשנה. מתחדש אוטומטית עד לביטול."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ آزمایش رایگان، سپس %@ در سال. به‌طور خودکار تا زمان لغو تمدید می‌شود."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uji cobalan gratis, kemudian %@ per tahun. Diperpanjang otomatis sampai dibatalkan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ujian percuma, kemudian %@ setahun. Diperbaharui secara automatik sehingga dibatalkan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ทดลองใช้งานฟรี จากนั้น %@ ต่อปี จะต่ออายุโดยอัตโนมัติจนกว่าจะยกเลิก"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ libreng pagsubok, pagkatapos ay %@ bawat taon. Awtomatikong nag-renew hanggang sa makansela."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dùng thử miễn phí, sau đó %@ mỗi năm. Tự động gia hạn cho đến khi bị hủy."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jaribio bure, kisha %@ kwa mwaka. Inajirudia kiotomatiki hadi ikataliwe."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gratis proef, dan %@ per jaar. Hernuwe outomaties totdat gekanselleer."
          }
