    "Search by book name, reference,\nor keyword.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search by book name, reference,\nor keyword."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca por nombre de libro, referencia\no palabra clave."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque por nome do livro, referência\nou palavra-chave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche par nom de livre, référence\nou mot-clé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche nach Buchname, Stelle\noder Stichwort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca per nome del libro, riferimento\no parola chiave."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szukaj według nazwy księgi, odwołania\nlub słowa kluczowego."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск по названию книги, ссылке\nили ключевому слову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按书卷名称、引用\n或关键词搜索。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依書卷名稱、引用\n或關鍵字搜尋。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책 이름, 구절 번호,\n또는 키워드로 검색해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書名・箇所・キーワードで\n検索できます。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari dengan nama kitab, ayat,\natau kata kunci."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maghanap gamit ang pangalan ng aklat,\nsanggunian, o keyword."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafuta kwa jina la kitabu, rejeleo,\nau neno kuu."
          }
        },
