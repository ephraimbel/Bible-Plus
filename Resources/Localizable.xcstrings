    "What do you need prayer for?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What do you need prayer for?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué necesitas oración?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo que você precisa de oração?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour quoi as-tu besoin de prière ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wofür brauchst du Gebet?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per cosa hai bisogno di preghiera?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О чём тебе нужна молитва?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你需要为何事祷告?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你需要為何事禱告?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 위한 기도가 필요하세요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何のために祈りが必要ですか?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk apa kamu butuh doa?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O co potrzebujesz modlitwy?"
          }
        },
