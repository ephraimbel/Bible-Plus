          "stringUnit": {
            "state": "translated",
            "value": "말씀과 기도, 묵상을 위한\n당신의 개인 가이드"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "みことば、祈り、黙想のための\nあなたの個人ガイド"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panduan pribadimu untuk Alkitab,\ndoa, dan renungan"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang iyong personal na gabay para sa Kasulatan,\npanalangin, at pagmumuni-muni"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwongozo wako wa kibinafsi wa Maandiko,\nsala, na tafakari"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ለቅዱሳት መጻሕፍት፣ ለጸሎት እና\nለማሰላሰል የአንተ የግል መመሪያ"
          }
        }
      }
    },
    "Your progress will be saved. You can restart this plan anytime.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your progress will be saved. You can restart this plan anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu progreso se guardará. Puedes reiniciar este plan cuando quieras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu progresso será salvo. Você pode reiniciar este plano quando quiser."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton progrès sera sauvegardé. Tu peux redémarrer ce plan à tout moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Fortschritt wird gespeichert. Du kannst den Plan jederzeit neu starten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo progresso sarà salvato. Puoi ricominciare questo piano quando vuoi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój postęp zostanie zapisany. Możesz w każdej chwili zacząć plan od nowa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой прогресс сохранится. Ты можешь перезапустить план в любой момент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的进度将被保存。你可以随时重新开始此计划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的進度會被儲存。你可以隨時重新開始此計畫。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 상황이 저장돼요. 언제든 이 플랜을 다시 시작할 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進捗は保存されます。いつでもこのプランを再開できます。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemajuanmu akan disimpan. Kamu bisa memulai kembali rencana ini kapan saja."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mase-save ang progreso mo. Maaari mong i-restart ang planong ito kahit kailan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Maendeleo yako yatahifadhiwa. Unaweza kuanza upya mpango huu wakati wowote."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ግስጋሴህ ይቀመጣል። ይህን ዕቅድ በማንኛውም ጊዜ እንደገና መጀመር ትችላለህ።"
          }
        }
      }
    },
    "Your rating helps others find\nGod's Word through this app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your rating helps others find\nGod's Word through this app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu calificación ayuda a otros a encontrar\nla Palabra de Dios a través de esta app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua avaliação ajuda outros a encontrar\na Palavra de Deus através deste app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta note aide d'autres à trouver\nla Parole de Dieu grâce à cette application."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bewertung hilft anderen,\nGottes Wort durch diese App zu finden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua valutazione aiuta altri a trovare\nla Parola di Dio attraverso questa app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja ocena pomaga innym znaleźć\nSłowo Boże przez tę aplikację."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоя оценка помогает другим найти\nСлово Божье через это приложение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的评分帮助更多人\n通过此应用认识神的话语。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的評分幫助更多人\n透過此應用程式認識神的話語。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 평가는 다른 사람들이 이 앱을\n통해 하나님의 말씀을 만나게 도와요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの評価は他の人がこのアプリで\n神の言葉に出会う助けになります。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulasanmu membantu orang lain menemukan\nFirman Tuhan lewat aplikasi ini."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumutulong ang iyong rating para matagpuan\nng iba ang Salita ng Diyos sa app na ito."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tathmini yako husaidia wengine kupata\nNeno la Mungu kupitia programu hii."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ግምገማህ ሌሎች በዚህ መተግበሪያ\nየእግዚአብሔርን ቃል እንዲያገኙ ይረዳል።"
          }
        }
      }
    },
    "Your reading plans will appear here\nonce content is loaded.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your reading plans will appear here\nonce content is loaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus planes de lectura aparecerán aquí\ncuando el contenido se cargue."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus planos de leitura aparecerão aqui\nquando o conteúdo for carregado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes plans de lecture apparaîtront ici\nune fois le contenu chargé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Lesepläne erscheinen hier,\nsobald der Inhalt geladen ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi piani di lettura appariranno qui\nuna volta caricati i contenuti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje plany czytania pojawią się tutaj,\ngdy zawartość zostanie załadowana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои планы чтения появятся здесь,\nкогда загрузится содержимое."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容加载后,你的阅读\n计划将出现在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容載入後,你的閱讀\n計畫將出現在這裡。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콘텐츠가 로드되면 여기에\n읽기 플랜이 표시돼요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツが読み込まれると、\nここに読書プランが表示されます。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rencana membacamu akan muncul di sini\nsetelah konten dimuat."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lilitaw dito ang iyong mga plano sa pagbabasa\nkapag na-load na ang nilalaman."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mipango yako ya kusoma itaonekana hapa\npindi maudhui yanapopakiwa."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይዘቱ በሚጫን ጊዜ የንባብ ዕቅዶችህ\nእዚህ ይታያሉ።"
          }
        }
      }
    },
