    "A reflection chosen for your evening is ready.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reflection chosen for your evening is ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una reflexión elegida para tu tarde está lista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma reflexão escolhida para sua noite está pronta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une réflexion choisie pour ta soirée est prête."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Reflexion für deinen Abend ist bereit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una riflessione scelta per la tua sera è pronta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozważanie wybrane na twój wieczór jest gotowe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размышление для твоего вечера готово."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为你傍晚准备的默想已就绪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為你傍晚準備的默想已就緒。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 저녁을 위해 선정된 묵상이 준비됐어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの夕べのために選ばれた黙想が届いています。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Renungan yang dipilih untuk malam ini sudah siap."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handa na ang pagninilay na pinili para sa iyong gabi."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafakari iliyochaguliwa kwa jioni yako iko tayari."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ለምሽትህ የተመረጠ ማሰላሰል ዝግጁ ነው።"
          }
        }
      }
    },
    "A verse picked just for you is waiting.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A verse picked just for you is waiting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un versículo elegido para ti te espera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um versículo escolhido para você está esperando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un verset choisi pour vous vous attend."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Vers, der nur für dich ausgewählt wurde, wartet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un versetto scelto per te ti sta aspettando."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany dla ciebie werset czeka."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стих, выбранный для тебя, ждёт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为你选的一节经文在等着。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為你選的一節經文在等著。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신을 위해 고른 말씀이 기다리고 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのために選んだみことばがあります。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayat yang dipilih untukmu sedang menunggu."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naghihintay sa'yo ang talatang pinili para sa'yo."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mstari uliochaguliwa kwa ajili yako unakungoja."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ላንተ የተመረጠ ጥቅስ እየጠበቀህ ነው።"
          }
        }
      }
    },
