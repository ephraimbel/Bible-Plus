    "You can upgrade to Pro from Settings anytime.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can upgrade to Pro from Settings anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes actualizar a Pro desde Ajustes cuando quieras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode assinar o Pro nas Configurações quando quiser."
          }
        },
