    "Read a chapter, save a verse, or write\na prayer to begin tracking your progress.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read a chapter, save a verse, or write\na prayer to begin tracking your progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee un capítulo, guarda un versículo o escribe\nuna oración para empezar a seguir tu progreso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia um capítulo, salve um versículo ou escreva\numa oração para começar a acompanhar seu progresso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lis un chapitre, enregistre un verset ou écris\nune prière pour commencer à suivre ton progrès."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies ein Kapitel, speichere einen Vers oder schreibe\nein Gebet, um deinen Fortschritt zu verfolgen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi un capitolo, salva un versetto o scrivi\nuna preghiera per iniziare a tracciare i progressi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeczytaj rozdział, zapisz werset lub napisz\nmodlitwę, aby rozpocząć śledzenie postępu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитай главу, сохрани стих или напиши\nмолитву, чтобы начать отслеживать прогресс."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读一章、收藏一节经文,或写下\n一篇祷告,开始追踪你的进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀一章、收藏一節經文,或寫下\n一篇禱告,開始追蹤你的進度。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 장을 읽거나, 한 구절을 저장하거나,\n기도를 적어 진행을 추적해 보세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "章を読み、みことばを保存し、\nまたは祈りを書いて進捗を追跡しましょう。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca satu pasal, simpan ayat, atau tulis\ndoa untuk mulai melacak kemajuanmu."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Basahin ang isang kabanata, mag-save ng talata, o sumulat\nng panalangin upang simulang subaybayan ang progreso."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma sura, hifadhi mstari, au andika\nsala ili kuanza kufuatilia maendeleo."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ምዕራፍ አንብብ፣ ጥቅስ አስቀምጥ ወይም ጸሎት ጻፍ\nየአንተን ግስጋሴ መከታተል ለመጀመር።"
          }
        }
      }
    },
