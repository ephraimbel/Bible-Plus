    "Add a fact (e.g. \\u{201C}Has a daughter named Sarah\\u{201D})": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a fact (e.g. \\u{201C}Has a daughter named Sarah\\u{201D})"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一个事实（例如：\\u{201C}有一个女儿叫莎拉\\u{201D}）"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir un hecho (p. ej. \\u{201C}Tiene una hija llamada Sarah\\u{201D})"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um fato (por exemplo, \\u{201C}Tem uma filha chamada Sarah\\u{201D})"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie eine Tatsache hinzu (z. B. \\u{201C}Hat eine Tochter namens Sarah\\u{201D})"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一個事實（例如：\\u{201C}有一個女兒名叫莎拉\\u{201D}）"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un fait (par exemple \\u{201C}A une fille nommée Sarah\\u{201D})"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan fakta (misalnya \\u{201C}Memiliki seorang putri bernama Sarah\\u{201D})"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사실 추가하기 (예: \\u{201C}사라라는 딸이 있습니다\\u{201D})"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un fatto (ad es. \\u{201C}Ha una figlia di nome Sarah\\u{201D})"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "事実を追加する（例：\\u{201C}サラという娘がいる\\u{201D}）"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeza ukweli (mfano: \\u{201C}Ana binti anayeitwa Sarah\\u{201D})"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj fakt (np. \\u{201C}Ma córkę o imieniu Sarah\\u{201D})"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Magdagdag ng katotohanan (hal. \\u{201C}May anak na babae na ang pangalan ay Sarah\\u{201D})"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте факт (например, \\u{201C}У меня есть дочь по имени Сара\\u{201D})"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "አንድ ዝርዝር ጨምር (ለምሳሌ \\u{201C}ሴት ልጅ አለው የሚባለው ሳራ\\u{201D})"
          }
        }
      }
    },
