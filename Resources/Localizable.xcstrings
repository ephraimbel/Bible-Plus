    "Premium guided journeys, unlimited concurrent plans, and deeper study.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium guided journeys, unlimited concurrent plans, and deeper study."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Viajes guiados premium, planes simultáneos ilimitados y estudio más profundo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jornadas guiadas premium, planos simultâneos ilimitados e estudos mais profundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcours guidés premium, plans simultanés illimités et étude approfondie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium-Reisen, unbegrenzt gleichzeitige Pläne und tiefere Studien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Percorsi guidati premium, piani simultanei illimitati e studio più profondo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium prowadzone drogi, nieograniczone plany i głębsze studium."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Премиум-путешествия, безлимитные планы и глубокое изучение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级带领之旅、无限同时进行的计划和更深入的研究。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高級引導之旅、無限同時進行的計畫和更深入的研究。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리미엄 여정, 무제한 동시 플랜, 더 깊은 학습을 누리세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレミアムな導きの旅、無制限の同時プラン、そして深い学び。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perjalanan premium, rencana bersamaan tanpa batas, dan studi lebih dalam."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium na ginagabayang paglalakbay, walang limitasyong sabay-sabay na plano, at mas malalim na pag-aaral."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari za kiongozi za premium, mipango isiyo na kikomo ya wakati mmoja, na masomo ya kina zaidi."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ፕሪሚየም የተመሩ ጉዞዎች፣ ያልተገደበ ተከታታይ ዕቅዶች እና ጥልቅ ጥናት።"
          }
        }
      }
    },
