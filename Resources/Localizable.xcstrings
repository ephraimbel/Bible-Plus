    "You've listened for a while. Tap Keep going to continue, or Stop to pause playback.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've listened for a while. Tap Keep going to continue, or Stop to pause playback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has escuchado un rato. Toca Sigue adelante para continuar o Detener para pausar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ouviu por um tempo. Toque Continuar para prosseguir ou Parar para pausar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu écoutes depuis un moment. Touche Continuer pour poursuivre, ou Arrêter pour mettre en pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hörst schon eine Weile. Tippe \"Weitermachen\" zum Fortsetzen oder \"Stoppen\" zum Pausieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai ascoltando da un po'. Tocca Continua per proseguire, o Ferma per mettere in pausa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słuchasz już chwilę. Naciśnij Nie przestawaj, aby kontynuować, lub Zatrzymaj, aby wstrzymać."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты слушаешь уже какое-то время. Нажми Продолжай, чтобы продолжить, или Стоп — чтобы приостановить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已经聆听了一段时间。点击“继续前进”继续,或“停止”暂停播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已聆聽一段時間。點擊「繼續前進」以繼續,或「停止」暫停播放。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한동안 들으셨네요. 계속하려면 '계속하세요'를, 일시 중지하려면 '정지'를 탭하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらく聴いています。「続けてください」で続行、「停止」で一時停止します。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sudah mendengarkan cukup lama. Ketuk Teruskan untuk lanjut, atau Berhenti untuk menjeda."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Matagal ka nang nakikinig. I-tap ang Magpatuloy para tumuloy, o Stop para ihinto muna."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Umesikiliza kwa muda. Gusa Endelea kuendelea, au Simamisha kusimamisha."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ለተወሰነ ጊዜ አዳምጠሃል። ለመቀጠል ቀጥል ወይም ለማቆም አቁም ንካ።"
          }
        }
      }
    },
