    "Start with the free version. Upgrade\nto Pro from Settings anytime.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with the free version. Upgrade\nto Pro from Settings anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comienza con la versión gratuita. Actualiza\na Pro desde Ajustes en cualquier momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com a versão gratuita. Assine\no Pro nas Configurações quando quiser."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence avec la version gratuite. Passe\nà Pro depuis les Réglages à tout moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte mit der kostenlosen Version. Upgrade\nauf Pro jederzeit in den Einstellungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con la versione gratuita. Passa a\nPro dalle Impostazioni quando vuoi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od wersji bezpłatnej. W każdej\nchwili możesz przejść na Pro w Ustawieniach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начни с бесплатной версии. Перейди\nна Pro в настройках в любое время."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从免费版开始。你可以\n随时在设置中升级到 Pro。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從免費版開始。你可以\n隨時在設定中升級到 Pro。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 버전으로 시작해요. 언제든\n설정에서 Pro로 업그레이드할 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版から始めましょう。設定から\nいつでもProにアップグレードできます。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dengan versi gratis. Tingkatkan\nke Pro di Pengaturan kapan saja."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Magsimula sa libreng bersyon. Mag-upgrade\nsa Pro mula sa Settings anumang oras."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Anza na toleo bila malipo. Pandisha\nhadi Pro kutoka Mipangilio wakati wowote."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በነጻው እትም ጀምር። በማንኛውም ጊዜ\nከቅንብሮች ወደ Pro አሻሽል።"
          }
        }
      }
    },
