    "No translations loaded yet. Pull to refresh from within the picker.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No translations loaded yet. Pull to refresh from within the picker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay traducciones. Desliza hacia abajo para recargar en el selector."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem traduções. Puxe para baixo para atualizar no seletor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune traduction chargée. Tire vers le bas pour actualiser dans le sélecteur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Übersetzungen geladen. Ziehe im Picker nach unten zum Aktualisieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna traduzione caricata. Tira verso il basso per aggiornare nel selettore."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wczytanych tłumaczeń. Pociągnij, aby odświeżyć w selektorze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводы ещё не загружены. Потяни вниз, чтобы обновить в выборе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未载入译本。请在选择器中下拉刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未載入譯本。請在選擇器中下拉重新整理。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 역본이 로드되지 않았어요. 선택기에서 아래로 당겨 새로고침하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訳がまだ読み込まれていません。ピッカー内で下に引っ張って更新してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada terjemahan yang dimuat. Tarik untuk menyegarkan di dalam pemilih."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang salin na na-load. Hilahin pababa para mag-refresh sa loob ng picker."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna tafsiri zilizopakiwa bado. Vuta chini kusasisha ndani ya kichagulia."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እስካሁን ትርጉሞች አልተጫኑም። ከመምረጫው ውስጥ ዳግም ለማደስ ወደታች ይጎትቱ።"
          }
        }
      }
    },
