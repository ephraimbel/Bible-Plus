    "Be still, and know\nthat I am God.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be still, and know\nthat I am God."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estad quietos, y conoced\nque yo soy Dios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquietai-vos, e sabei\nque eu sou Deus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez, et sachez\nque je suis Dieu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seid stille und erkennet,\ndass ich Gott bin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermatevi e riconoscete\nche io sono Dio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановитесь и познайте,\nчто Я — Бог."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你们要休息，要知道\n我是神。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你們要休息,要知道\n我是神。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너희는 가만히 있어\n내가 하나님 됨을 알지어다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静まれ、わたしこそ\n神であることを知れ。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diamlah, dan ketahuilah\nbahwa Akulah Allah."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uspokójcie się i poznajcie,\nże Ja jestem Bogiem."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumigil kayo at kilalanin\nna Ako ay Diyos."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulieni, na kujua\nya kuwa mimi ni Mungu."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ጸጥ በሉ እና እኔ\nእግዚአብሔር መሆኔን እወቁ።"
          }
        }
      }
    },
