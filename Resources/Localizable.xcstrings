    "Your faithfulness in God's Word\nis building something beautiful.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your faithfulness in God's Word\nis building something beautiful."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu fidelidad en la Palabra de Dios\nestá construyendo algo hermoso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua fidelidade à Palavra de Deus\nestá construindo algo lindo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta fidélité dans la Parole de Dieu\nconstruit quelque chose de beau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Treue zum Wort Gottes\nbaut etwas Schönes auf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua fedeltà alla Parola di Dio\nsta costruendo qualcosa di bello."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja wierność Słowu Bożemu\nbuduje coś pięknego."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоя верность Слову Божьему\nстроит что-то прекрасное."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你对神话语的忠心\n正在建造美好的事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你對神話語的忠心\n正在建造美好的事。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나님의 말씀 안에서의 당신의 신실함이\n아름다운 무언가를 지어가고 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "神の言葉における忠実さが\n美しいものを築いています。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesetiaanmu pada Firman Tuhan\nsedang membangun sesuatu yang indah."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang iyong katapatan sa Salita ng Diyos\nay nagtatayo ng isang bagay na maganda."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uaminifu wako katika Neno la Mungu\nunajenga jambo zuri."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በእግዚአብሔር ቃል ውስጥ ያለህ ታማኝነት\nውብ የሆነ ነገር እየገነባ ነው።"
          }
        }
      }
    },
