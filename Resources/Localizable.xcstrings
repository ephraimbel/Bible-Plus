          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna usajili wa Bible+ Pro ulio hai uliopatikana kwa Apple ID hii."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy đăng ký Bible+ Pro nào cho Apple ID này."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen aktiewe Bible+ Pro intekening is vir hierdie Apple ID gevind nie."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Babu rajistar Bible+ Pro mai aiki da aka samu don wannan Apple ID."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko si alabapin Bible+ Pro ti n ṣiṣẹ ti a ri fun ID Apple yii."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצאה מנוי פעיל של Bible+ Pro עבור מזהה Apple זה."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ለዚህ Apple ID አንደኛ የሆነ Bible+ Pro እንደገና የሚሰራ ስምምነት አልተገኘም።"
          }
        }
      }
    },
    "No pinned facts yet. Tell the AI something like “remember that I have a daughter named Sarah” and it will appear here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No pinned facts yet. Tell the AI something like “remember that I have a daughter named Sarah” and it will appear here."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há fatos fixados. Diga à IA algo como “lembre-se de que tenho uma filha chamada Sarah” e aparecerá aqui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay hechos fijados aún. Dile a la IA algo como “recuerda que tengo una hija llamada Sarah” y aparecerá aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine festgepinnten Fakten. Sagen Sie der KI etwas wie „Erinnere dich daran, dass ich eine Tochter namens Sarah habe“ und es wird hier erscheinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun fait épinglé pour l'instant. Dites à l'IA quelque chose comme “rappelez-vous que j'ai une fille nommée Sarah” et cela apparaîtra ici."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há fatos fixados. Diga à IA algo como “lembre-se que tenho uma filha chamada Sarah” e aparecerá aqui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun fatto fissato ancora. Dì all'AI qualcosa come “ricorda che ho una figlia di nome Sarah” e apparirà qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen vastgezette feiten. Vertel de AI iets als “onthoud dat ik een dochter heb genaamd Sarah” en het zal hier verschijnen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen festede fakta ennå. Fortell AI noe som “husk at jeg har en datter som heter Sarah” så vil det vises her."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga fästa fakta ännu. Berätta för AI:n något som “kom ihåg att jag har en dotter som heter Sarah” så kommer det att visas här."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze przypiętych faktów. Powiedz AI coś w stylu „zapamiętaj, że mam córkę o imieniu Sarah”, a pojawi się tutaj."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen fastgjorte fakta endnu. Fortæl AI noget som “huske at jeg har en datter ved navn Sarah”, så vil det vises her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä kiinnitettyjä tietoja. Kerro AI:lle jotain kuten “muista, että minulla on tytär nimeltä Sarah”, niin se ilmestyy tänne."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nejsou žádná připnutá fakta. Řekněte AI něco jako „pamatuj, že mám dceru jménem Sarah“ a objeví se to zde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există încă fapte fixate. Spuneți AI ceva de genul „amintește-ți că am o fiică pe nume Sarah” și va apărea aici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincsenek rögzített tények. Mondj az AI-nak valami olyasmit, mint például „jegyezd meg, hogy van egy lányom, akit Sarah-nak hívnak”, és itt fog megjelenni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет закрепленных фактов. Скажите ИИ что-то вроде “помни, что у меня есть дочь по имени Сара”, и это появится здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无固定事实。告诉人工智能一些类似“记住我有一个名叫莎拉的女儿”的信息，它将出现在这里。"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ακόμα αποθηκευμένα γεγονότα. Πείτε στην AI κάτι όπως «θυμήσου ότι έχω μια κόρη που ονομάζεται Σάρα» και θα εμφανιστεί εδώ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz sabitlenmiş bir bilgi yok. AI'ya “Sarah adında bir kızım olduğunu hatırla” gibi bir şey söyleyin, burada görünecektir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未固定任何事實。告訴 AI 一些類似“記住我有一個女兒叫莎拉”的話，它將出現在這裡。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 고정된 사실이 없습니다. AI에게 “사라라는 딸이 있다는 것을 기억해 주세요”와 같은 내용을 말하면 여기 나타납니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだピン留めされた事実はありません。「サラという名前の娘がいることを覚えておいて」とAIに伝えると、ここに表示されます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще немає закріплених фактів. Скажіть ШІ щось на кшталт “запам'ятай, що у мене є дочка на ім'я Сара”, і це з'явиться тут."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई पिन किए गए तथ्य नहीं हैं। एआई को कुछ ऐसा बताएं जैसे “याद रखें कि मेरी एक बेटी है जिसका नाम सारा है” और यह यहाँ दिखाई देगा।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد حقائق مثبتة بعد. أخبر الذكاء الاصطناعي بشيء مثل “تذكر أن لدي ابنة اسمها سارة” وستظهر هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোন পিন করা তথ্য নেই। AI কে বলুন “মনে রেখো যে আমার একটি কন্যা আছে যার নাম সারাহ” এবং এটি এখানে প্রদর্শিত হবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی تک کوئی پن کیے گئے حقائق نہیں ہیں۔ AI کو کچھ ایسا بتائیں جیسے “یاد رکھیں کہ میری ایک بیٹی ہے جس کا نام سارہ ہے” اور یہ یہاں ظاہر ہوگا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada fakta yang dipasang. Beritahu AI sesuatu seperti “ingat bahwa saya memiliki seorang putri bernama Sarah” dan itu akan muncul di sini."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز هیچ واقعیت پین شده‌ای وجود ندارد. به AI بگویید چیزی مانند “به یاد داشته باش که من دختری به نام سارا دارم” و اینجا ظاهر خواهد شد."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang naka-pin na katotohanan pa. Sabihin sa AI ang isang bagay tulad ng “tandaan na mayroon akong anak na babae na ang pangalan ay Sarah” at ito ay lilitaw dito."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada fakta yang disematkan lagi. Beritahu AI sesuatu seperti “ingat bahawa saya mempunyai seorang anak perempuan bernama Sarah” dan ia akan muncul di sini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีข้อเท็จจริงที่ถูกปักหมุด บอก AI ว่า “จำไว้ว่าฉันมีลูกสาวชื่อซาราห์” แล้วมันจะปรากฏที่นี่"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna ukweli uliofungwa bado. Mwambie AI kitu kama “kumbuka nina binti anayeitwa Sarah” na kitaonekana hapa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có thông tin nào được ghim. Hãy nói với AI điều gì đó như “nhớ rằng tôi có một cô con gái tên là Sarah” và nó sẽ xuất hiện ở đây."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen vasgepinde feite nog. Sê vir die KI iets soos “onthou dat ek 'n dogter met die naam Sarah het” en dit sal hier verskyn."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Babu bayanai da aka danna har yanzu. Faɗa wa AI wani abu kamar “ka tuna cewa ina da 'yar mata mai suna Sarah” kuma zai bayyana anan."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko si awọn otitọ ti a fi pamọ sibẹsibẹ. So fun AI nkan bi “ranti pe mo ni ọmọbirin kan ti a npè ni Sarah” ati pe yóò hàn nibi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין עובדות מוצמדות. תגיד ל-AI משהו כמו “זכור שיש לי בת בשם שרה” וזה יופיע כאן."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እስካሁን የታሰበ ዝርዝር የለም። አይ አንድ ነገር እንደ “ሳራ የሚባለ ወንድም እንደ እኔ እንደ ወንድም ይዘው አስታውስ” ይነግሩት እና እዚህ ይታይ።"
          }
        }
      }
    },
