    "Everything you need\nto grow closer to God.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you need\nto grow closer to God."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo que você precisa\npara se aproximar de Deus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que necesitas\npara acercarte más a Dios."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was Sie brauchen,\num näher zu Gott zu wachsen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce dont vous avez besoin\npour vous rapprocher de Dieu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que precisa\npara se aproximar de Deus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò di cui hai bisogno\nper avvicinarti a Dio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat je nodig hebt\nom dichter bij God te komen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt du trenger\nfor å komme nærmere Gud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt du behöver\nför att komma närmare Gud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt hvad du behøver\ntil at komme tættere på Gud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, czego potrzebujesz,\naby zbliżyć się do Boga."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki mitä tarvitset\nlähetäksesi Jumalan lähelle."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše, co potřebujete\nk tomu, abyste se přiblížili k Bohu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot ce ai nevoie\npentru a te apropia de Dumnezeu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden, amire szükséged van,\nhogy közelebb kerülj Istenhez."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα όσα χρειάζεστε\nγια να πλησιάσετε περισσότερο τον Θεό."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все, что вам нужно,\nчтобы стать ближе к Богу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanrı'ya daha yakınlaşmak için ihtiyacınız olan her şey."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您所需的一切\n以更接近上帝。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Все, що вам потрібно,\nщоб наблизитися до Бога."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您所需的一切\n以更接近上帝。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나님과 더 가까워지기 위해 필요한 모든 것입니다.\n"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "神に近づくために必要なすべてがここにあります。\n"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको भगवान के करीब लाने के लिए\nto सब कुछ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার প্রয়োজনীয় সবকিছু\nঈশ্বরের কাছে আরও ঘনিষ্ঠ হতে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر چیز جو آپ کو خدا کے قریب ہونے کے لیے درکار ہے۔"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما تحتاجه\nلتقرب من الله."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מה שאתה צריך\nכדי להתקרב יותר לאלוהים."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر آنچه که برای نزدیک‌تر شدن به خدا نیاز دارید."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Segala yang Anda butuhkan\nuntuk mendekat kepada Tuhan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Segala yang anda perlukan\nuntuk mendekatkan diri kepada Tuhan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกสิ่งที่คุณต้องการ\nเพื่อเข้าใกล้พระเจ้า."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lahat ng kailangan mo\nupang lumapit sa Diyos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả những gì bạn cần\nđể gần gũi hơn với Chúa."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kila kitu unachohitaji\nkujiweka karibu na Mungu."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
