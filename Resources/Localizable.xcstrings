    "No digest yet. After a few conversations, Bible+ will start to build one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No digest yet. After a few conversations, Bible+ will start to build one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay resumen. Después de unas conversaciones, Bible+ empezará a crear uno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem resumo. Após algumas conversas, o Bible+ começará a construir um."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de résumé. Après quelques conversations, Bible+ commencera à en créer un."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Zusammenfassung. Nach einigen Unterhaltungen beginnt Bible+, eine zu erstellen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna sintesi ancora. Dopo alcune conversazioni, Bible+ inizierà a costruirne una."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak podsumowania. Po kilku rozmowach Bible+ zacznie je tworzyć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет сводки. После нескольких разговоров Bible+ начнёт её создавать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无摘要。经过几次对话后,Bible+ 会开始建立摘要。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫無摘要。幾次對話後,Bible+ 會開始建立摘要。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 요약이 없어요. 몇 번의 대화 후 Bible+가 요약을 만들 거예요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ要約はありません。数回の会話の後、Bible+が作成を始めます。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada ringkasan. Setelah beberapa percakapan, Bible+ akan mulai membangunnya."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang buod. Pagkatapos ng ilang usapan, magsisimula ang Bible+ na gumawa ng buod."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna muhtasari bado. Baada ya mazungumzo machache, Bible+ itaanza kuujenga."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እስካሁን ማጠቃለያ የለም። ከጥቂት ውይይቶች በኋላ Bible+ መገንባት ይጀምራል።"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem resumo. Após algumas conversas, o Bible+ começará a construir um."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen samenvatting. Na een paar gesprekken zal Bible+ beginnen er een te bouwen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen oppsummering ennå. Etter noen samtaler vil Bible+ begynne å bygge en."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen sammanfattning än. Efter några samtal kommer Bible+ att börja bygga en."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen opsummering endnu. Efter et par samtaler vil Bible+ begynde at opbygge en."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä tiivistelmää. Muutaman keskustelun jälkeen Bible+ alkaa rakentaa sellaista."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádný souhrn. Po několika konverzacích začne Bible+ jeden vytvářet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs összefoglaló. Néhány beszélgetés után a Bible+ elkezdi létrehozni azt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există un rezumat. După câteva conversații, Bible+ va începe să construiască unul."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει ακόμη περίληψη. Μετά από μερικές συνομιλίες, το Bible+ θα αρχίσει να δημιουργεί μία."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz bir özet yok. Birkaç konuşmadan sonra, Bible+ bir özet oluşturmaya başlayacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще немає дайджесту. Після кількох розмов Bible+ почне його формувати."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई संक्षेप नहीं है। कुछ बातचीतों के बाद, Bible+ एक बनाना शुरू करेगा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোনো সারসংক্ষেপ নেই। কয়েকটি কথোপকথনের পরে, Bible+ একটি তৈরি করতে শুরু করবে।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد ملخص بعد. بعد بضع محادثات، سيبدأ Bible+ في بناء واحد."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی خلاصہ نہیں ہے۔ چند گفتگووں کے بعد، Bible+ ایک بنانا شروع کرے گا۔"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין סיכום עדיין. לאחר מספר שיחות, Bible+ יתחיל לבנות אחד."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز هیچ خلاصه‌ای وجود ندارد. پس از چند مکالمه، Bible+ شروع به ساخت یکی خواهد کرد."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada ringkasan lagi. Selepas beberapa perbualan, Bible+ akan mula membina satu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีการสรุป หลังจากการสนทนาสองสามครั้ง Bible+ จะเริ่มสร้างการสรุป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có tóm tắt nào. Sau một vài cuộc trò chuyện, Bible+ sẽ bắt đầu xây dựng một cái."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen opsomming nog nie. Na 'n paar gesprekke sal Bible+ begin om een te bou."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko si akopọ sibẹsibẹ. Lẹhin diẹ ninu awọn ibaraẹnisọrọ, Bible+ yoo bẹrẹ lati kọ ọkan."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Babu takaitaccen bayani tukuna. Bayan wasu tattaunawa, Bible+ zai fara gina guda."
          }
        }
      }
    },
    "No pinned facts yet. Tell the AI something like \\u{201C}remember that I have a daughter named Sarah\\u{201D} and it will appear here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No pinned facts yet. Tell the AI something like \\u{201C}remember that I have a daughter named Sarah\\u{201D} and it will appear here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未固定任何事实。告诉AI一些像\\u{201C}记得我有一个女儿叫莎拉\\u{201D}的内容，它将出现在这里。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay hechos fijados. Dile a la IA algo como \\u{201C}recuerda que tengo una hija llamada Sarah\\u{201D} y aparecerá aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há fatos fixados. Diga à IA algo como \\u{201C}lembre-se de que tenho uma filha chamada Sarah\\u{201D} e aparecerá aqui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine festgepinnten Fakten. Sagen Sie der KI etwas wie \\u{201C}erinnere dich, dass ich eine Tochter namens Sarah habe\\u{201D} und es wird hier erscheinen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未固定任何事實。告訴AI一些像是\\u{201C}記得我有一個女兒名叫莎拉\\u{201D}的話，它將會出現在這裡。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun fait épinglé pour l'instant. Dites à l'IA quelque chose comme \\u{201C}rappelez-vous que j'ai une fille nommée Sarah\\u{201D} et cela apparaîtra ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada fakta yang dipin. Beritahu AI sesuatu seperti \\u{201C}ingat bahwa saya memiliki seorang putri bernama Sarah\\u{201D} dan itu akan muncul di sini."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 고정된 사실이 없습니다. AI에게 \\u{201C}사라라는 딸이 있다는 것을 기억해 주세요\\u{201D}와 같은 내용을 말하면 여기에 나타납니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono fatti appuntati. Dì all'AI qualcosa come \\u{201C}ricorda che ho una figlia di nome Sarah\\u{201D} e apparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ固定された事実はありません。AIに「サラという娘がいることを覚えておいて」と言ってください。ここに表示されます。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna ukweli uliofungwa bado. Mwambie AI kitu kama \\u{201C}kumbuka kuwa nina binti anayeitwa Sarah\\u{201D} na itatokea hapa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze przypiętych faktów. Powiedz AI coś w stylu \\u{201C}zapamiętaj, że mam córkę o imieniu Sarah\\u{201D}, a to się tutaj pojawi."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang naka-pin na katotohanan. Sabihin sa AI ng isang bagay tulad ng \\u{201C}alalahanin na mayroon akong anak na babae na ang pangalan ay Sarah\\u{201D} at ito ay lilitaw dito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет закрепленных фактов. Скажите ИИ что-то вроде \\u{201C}запомни, что у меня есть дочь по имени Сара\\u{201D}, и это появится здесь."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እስካሁን የታመነ ዝርዝር የለም። አይ አንድ ነገር እንደ \\u{201C}እኔ የምርምር ሴት አለኝ የሚለውን ነገር አስታውስ\\u{201D} በማለት ይነግሩዋት፣ እና እዚህ ይታይ።"
          }
        }
      }
    },
