      }
    },
    "This deletes every pinned fact and the rolling digest. The AI will start fresh from your next message. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes every pinned fact and the rolling digest. The AI will start fresh from your next message. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra cada dato guardado y el resumen. La IA empezará de cero desde tu próximo mensaje. No se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga todos os fatos fixados e o resumo. A IA começará do zero na próxima mensagem. Não pode ser desfeito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime tous les faits épinglés et le résumé. L'IA repartira de zéro à ton prochain message. Irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht alle gepinnten Fakten und die Zusammenfassung. Die KI startet bei deiner nächsten Nachricht neu. Nicht rückgängig zu machen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elimina ogni fatto fissato e la sintesi. L'IA ripartirà dal prossimo messaggio. Non annullabile."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To usuwa wszystkie przypięte fakty i podsumowanie. AI zacznie od zera przy następnej wiadomości. Nie można cofnąć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удаляет все закреплённые факты и сводку. ИИ начнёт заново со следующего сообщения. Нельзя отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除所有已钉住的事实与滚动摘要。AI 将从你的下一条消息重新开始。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將刪除所有釘住的事實與滾動摘要。AI 將從你的下一則訊息重新開始。無法復原。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 모든 사실과 요약을 삭제해요. AI는 다음 메시지부터 새로 시작해요. 되돌릴 수 없어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "留めてあるすべての事実と継続的な要約を削除します。AIは次のメッセージから新しく始めます。取り消せません。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapus semua fakta yang dicatat dan ringkasan. AI akan mulai dari awal di pesan berikutnya. Tidak bisa dibatalkan."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bubura nito ang lahat ng naka-pin na mga katotohanan at ang rolling digest. Magsisimula muli ang AI sa iyong susunod na mensahe. Hindi na ito maibabalik."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hii inafuta kila ukweli uliowekwa na muhtasari. AI itaanza upya kutoka kwa ujumbe wako ujao. Haiwezi kutenduliwa."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ ሁሉንም የተለጠፉ እውነታዎች እና ማጠቃለያ ይሰርዛል። AI ከቀጣይ መልዕክትህ አዲስ ይጀምራል። ሊመለስ አይችልም።"
          }
        }
      }
    },
