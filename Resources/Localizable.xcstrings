    "See personalized prayers and verses\nevery time you unlock your phone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See personalized prayers and verses\nevery time you unlock your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve oraciones y versículos personalizados\ncada vez que desbloquees tu teléfono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja orações e versículos personalizados\nsempre que desbloquear seu celular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vois des prières et versets personnalisés\nchaque fois que tu déverrouilles ton téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh personalisierte Gebete und Verse,\njedes Mal wenn du dein Handy entsperrst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi preghiere e versetti personalizzati\nogni volta che sblocchi il telefono."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz spersonalizowane modlitwy i wersety\nza każdym razem, gdy odblokujesz telefon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видь персональные молитвы и стихи\nкаждый раз, когда разблокируешь телефон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次解锁手机时都看到\n个性化的祷告与经文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次解鎖手機時都看到\n個人化的禱告與經文。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰을 잠금 해제할 때마다\n맞춤형 기도와 말씀을 보세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホを解除するたびに、\nあなた専用の祈りとみことばを。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat doa dan ayat yang dipersonalisasi\nsetiap kali kamu membuka kunci HP."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Makita ang personalisadong mga panalangin at talata\nsa tuwing ia-unlock mo ang telepono mo."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ona sala na mistari ya kibinafsi\nkila unapofungua simu yako."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ስልክህን በከፈትክ ቁጥር የግል ጸሎቶችን\nእና ጥቅሶችን ተመልከት።"
          }
        }
      }
    },
