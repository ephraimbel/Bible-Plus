    "Each card shows John 3:16 so you can\ncompare tone and feel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each card shows John 3:16 so you can\ncompare tone and feel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada tarjeta muestra Juan 3:16 para que puedas\ncomparar el tono y la sensación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cartão mostra João 3:16 para que você\ncompare o tom e a sensação."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque carte montre Jean 3:16 pour que tu puisses\ncomparer le ton et la sensation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Karte zeigt Johannes 3,16, damit du\nTon und Gefühl vergleichen kannst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni scheda mostra Giovanni 3:16 così puoi\nconfrontare il tono e la sensazione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda karta pokazuje J 3,16, abyś\nmógł porównać ton i styl."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая карточка показывает Ин. 3:16,\nчтобы ты сравнил тон и ощущение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每张卡片都展示约翰福音 3:16,\n方便你比较风格与感受。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每張卡片都顯示約翰福音 3:16,\n方便你比較風格與感受。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 카드는 요한복음 3:16을 보여드려요.\n분위기와 느낌을 비교해 보세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各カードにはヨハネ 3:16 が表示され、\n雰囲気や感触を比較できます。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap kartu menampilkan Yohanes 3:16\nagar kamu bisa membandingkan nuansa."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapakita ng bawat card ang Juan 3:16\npara maikumpara mo ang tono at pakiramdam."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kila kadi inaonyesha Yohana 3:16 ili\nuweze kulinganisha sauti na hisia."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እያንዳንዱ ካርድ ዮሐንስ 3:16 ያሳያል፣\nቅላጼ እና ስሜት ልታወዳድር ትችላለህ።"
          }
        }
      }
    },
